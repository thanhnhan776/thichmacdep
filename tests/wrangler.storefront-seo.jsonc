{
  "name": "storefront-seo-test",
  "main": "storefront-seo-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],
  "assets": {
    "directory": "../apps/storefront/dist/storefront/browser",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
