{
  "name": "thichmacdep",
  "private": true,
  "scripts": {
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787 --env-file .env",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
    "typecheck:api": "tsc --noEmit",
    "test:api": "node --test tests/api.test.mjs",
    "test:sync": "node --test tests/sync-repository.test.mjs",
    "dev:storefront": "pnpm --filter storefront start",
    "build:storefront": "pnpm --filter storefront build",
    "test:storefront": "pnpm --filter storefront test --watch=false",
    "test:storefront:ssr": "pnpm build:storefront && node --test tests/storefront-ssr.test.mjs",
    "test:storefront:proxy": "node --test tests/storefront-proxy.test.mjs",
    "test:storefront:catalog": "node --test tests/storefront-catalog-proof.test.mjs",
    "test:storefront:browser": "node --test tests/storefront-browser.test.mjs",
    "dev:storefront:worker": "pnpm build:storefront && wrangler dev -c apps/storefront/wrangler.jsonc -c wrangler.jsonc --local --ip 127.0.0.1 --port 4200 --persist-to .wrangler/state --env-file .env --var SITE_ORIGIN:http://localhost:4200"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "wrangler": "4.160.0"
  }
}
