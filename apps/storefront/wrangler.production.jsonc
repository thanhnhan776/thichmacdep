{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thichmacdep",
  "main": "dist/storefront/server/server.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://thichmacdep.nhanttdev.workers.dev"
  },
  "services": [{ "binding": "API", "service": "thichmacdep-api" }],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "81917001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ADMIN_WRITE_RATE_LIMITER", "namespace_id": "81917002", "simple": { "limit": 60, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist/storefront/browser",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
